{
  "name": "grabbit",
  "version": "0.1.1",
  "description": "High-performance, feature-rich modern download manager built with Electron, React, and TypeScript.",
  "main": "./out/main/index.js",
  "author": {
    "name": "HawkdotDev",
    "url": "https://github.com/HawkdotDev"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/HawkdotDev/grabbit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HawkdotDev/grabbit.git"
  },
  "bugs": {
    "url": "https://github.com/HawkdotDev/grabbit/issues"
  },
  "keywords": [
    "electron",
    "download-manager",
    "download-accelerator",
    "react",
    "typescript",
    "vite",
    "bittorrent",
    "desktop-app",
    "open-source"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "build": "bun run typecheck && electron-vite build",
    "build:dir": "bun run build && electron-builder --dir",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux",
    "build:all": "bun run build && electron-builder --win --mac --linux",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "clean": "node -e \"['out', 'dist'].forEach(d => require('fs').rmSync(d, { recursive: true, force: true }))\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "Chrome >= 120",
    "last 2 Electron versions"
  ],
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.28.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webtorrent": "^0.110.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
